# Which commerce backend to use: mock | shopify | odoo
COMMERCE_PROVIDER=mock

# --- Shopify (only needed when COMMERCE_PROVIDER=shopify) ---
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_TOKEN=

# --- Odoo (only needed when COMMERCE_PROVIDER=odoo) ---
ODOO_URL=https://your-odoo-instance.example.com
ODOO_DB=your-db-name
ODOO_API_KEY=

# --- Razorpay (payments) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Admin (Add Product page) ---
ADMIN_PASSWORD=
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=

# --- Analytics / marketing (optional, add when ready) ---
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
